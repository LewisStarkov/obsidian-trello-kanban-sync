{
	"name": "trello-kanban-sync",
	"version": "0.1.1",
	"description": "Mirrors Trello boards into native Obsidian Kanban-plugin boards, one-way, on an interval.",
	"main": "main.js",
	"scripts": {
		"dev": "node esbuild.config.mjs",
		"build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
	},
	"license": "MIT",
	"devDependencies": {
		"@types/node": "^20.0.0",
		"builtin-modules": "^3.3.0",
		"esbuild": "^0.20.0",
		"obsidian": "^1.4.11",
		"typescript": "^5.4.0"
	}
}
